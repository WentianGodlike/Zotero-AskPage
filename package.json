{
  "name": "zotero-askpage",
  "type": "module",
  "version": "0.20.0",
  "description": "Highlight text in Zotero PDF reader and ask DeepSeek to explain it.",
  "config": {
    "addonName": "AskPage",
    "addonID": "highlight-ask@yangruiyu.dev",
    "addonRef": "highlightask",
    "addonInstance": "HighlightAsk",
    "prefsPrefix": "extensions.zotero.highlightask"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WentianGodlike/Zotero-AskPage.git"
  },
  "author": "yangruiyu (based on zotero-plugin-template by windingwind and contributors)",
  "bugs": {
    "url": "https://github.com/WentianGodlike/Zotero-AskPage/issues"
  },
  "homepage": "https://github.com/WentianGodlike/Zotero-AskPage#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "python3 scripts/copy-katex-fonts.py && zotero-plugin build && tsc --noEmit && python3 scripts/check-sandbox-globals.py && python3 scripts/check-manifest.py && python3 scripts/check-pane.py && python3 scripts/check-package.py && python3 scripts/check-template-literals.py && python3 scripts/check-cross-platform.py",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:local",
    "update-deps": "npm update --save",
    "test:local": "esbuild test/local.test.ts --bundle --platform=node --format=esm --outfile=.scaffold/local.test.mjs --log-level=warning && node .scaffold/local.test.mjs",
    "check": "tsc --noEmit && npm run test:local",
    "icons": "python3 scripts/make-icons.py",
    "check:manifest": "python3 scripts/check-manifest.py",
    "check:pane": "python3 scripts/check-pane.py",
    "diagnose": "node scripts/diagnose-pane.mjs",
    "check:package": "python3 scripts/check-package.py",
    "check:sandbox": "python3 scripts/check-sandbox-globals.py",
    "test:zotero": "zotero-plugin test"
  },
  "dependencies": {
    "katex": "^0.18.9",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3",
    "@types/katex": "^0.16.8"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "engines": {
    "node": ">=22.8.0",
    "npm": ">=10"
  }
}
